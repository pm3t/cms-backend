{
  "version": 2,
  "name": "eklesia-backend",
  "builds": [
    {
      "src": "src/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/api/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/jobs/subscription-cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/jobs/birthday-greetings",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/jobs/sunday-greetings",
      "schedule": "0 6 * * 0"
    }
  ]
}
