generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id     String  @id @default(uuid())
  name   String
  domain String? @unique
  
  websiteActive Boolean @default(false)
  websitePath   String? @unique
  websiteTheme  String  @default("classic")

  // Profile
  address String?
  phone   String?
  email   String?

  // Configuration
  timezone String @default("Asia/Jakarta")
  currency String @default("IDR")
  language String @default("id")
  ageGroupRules Json?

  // Branding
  logoUrl      String?
  primaryColor String  @default("#3b82f6")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  roles             Role[]
  branches          Branch[]
  members           Member[]
  families          Family[]
  announcements     Announcement[]
  commTemplates     CommunicationTemplate[]
  commLogs          CommunicationLog[]
  financialRecords  FinancialRecord[]
  events            Event[]
  worshipServices   WorshipService[]
  attendanceRecords AttendanceRecord[]
  smallGroups       SmallGroup[]
  newsletters       Newsletter[]
  donationProjects  DonationProject[]
  pledges           Pledge[]
  budgets           Budget[]

  planId String? @map("plan_id")
  plan   Plan?   @relation(fields: [planId], references: [id])

  subscriptions Subscription[]
  invoices      Invoice[]

  ministries          Ministry[]
  pastoralVisitations PastoralVisitation[]
  counselingRecords   CounselingRecord[]
  prayerRequests      PrayerRequest[]
  careGroups          CareGroup[]
  crisisRecords       CrisisRecord[]
  emergencyContacts   EmergencyContact[]

  documents     Document[]
  certificates  Certificate[]
  certTemplates CertificateTemplate[]

  facilities           Facility[]
  facilityBookings     FacilityBooking[]
  equipments           Equipment[]
  maintenanceSchedules MaintenanceSchedule[]
  utilityRecords       UtilityRecord[]

  reportTemplates        ReportTemplate[]
  sermons                Sermon[]
  bulletins              Bulletin[]
  digitalConfig          DigitalConfig?
  skills                 Skill[]
  smallGroupJoinRequests SmallGroupJoinRequest[]
  sacramentRequests      SacramentRequest[]
  notifications          Notification[]
  memberActivityLogs     MemberActivityLog[]
  dailyDevotions         DailyDevotion[]
  bibleReadingPlans      BibleReadingPlan[]
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  email        String
  password     String
  name         String
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id])
  totpSecret   String?
  is2FAEnabled Boolean  @default(false)
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  announcements Announcement[] @relation("AnnouncementAuthor")

  @@unique([email, tenantId])
}

model Role {
  id          String           @id @default(uuid())
  name        String
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]

  // Commonly Pastor, Pengurus, Staff, Jemaat
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  resource  String
  details   Json?
  createdAt DateTime @default(now())
}

model MemberActivityLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  action    String   // e.g. LOGIN, OPEN_APP, REGISTER_EVENT, SUBMIT_PRAYER
  device    String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([memberId])
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  CANDIDATE
  GUEST
}

enum MemberCategory {
  CHILDREN
  YOUTH
  ADULT
  ELDERLY
}

enum SacramentType {
  BAPTISM
  CONFIRMATION
}

model Family {
  id   String @id @default(uuid())
  name String // E.g. "Keluarga Panjaitan"

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // This relation points to a specific Member who acts as the head
  // Wait, circular relation might cause issues on initial insert, we map it nullable
  headOfFamilyId String? @unique
  headOfFamily   Member? @relation("FamilyHead", fields: [headOfFamilyId], references: [id], onDelete: SetNull)

  members Member[] @relation("FamilyMembers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id         String    @id @default(uuid())
  firstName  String
  lastName   String?
  gender     String? // 'M' or 'F'
  birthDate  DateTime?
  birthPlace String?

  phone           String?
  email           String?
  address         String?
  photoUrl        String?
  referenceNumber String?

  status   MembershipStatus @default(ACTIVE)
  category MemberCategory   @default(ADULT)

  // Privacy configuration (e.g., hidden from public member directory)
  isPrivate Boolean @default(false)

  // Mobile App fields
  passwordHash    String?
  pushToken       String?
  resetOtp        String?
  resetOtpExpires DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  familyId String?
  family   Family? @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: SetNull)

  // Reverse relation for head of family
  headedFamily Family? @relation("FamilyHead")

  sacraments         SacramentRecord[]
  donations          FinancialRecord[]
  pledges            Pledge[]
  eventRegistrations EventRegistration[]
  attendance         AttendanceRecord[]

  smallGroupMemberships SmallGroupMember[]
  smallGroupAttendances SmallGroupAttendance[]

  ministryMemberships    MinistryMember[]
  skills                 MemberSkill[]
  volunteerApplications  VolunteerApplication[]
  servicePositions       ServicePosition[]
  pastoralVisitations    PastoralVisitation[]
  counselingRecords      CounselingRecord[]
  prayerRequests         PrayerRequest[]
  careGroupMemberships   CareGroupMember[]
  crisisRecords          CrisisRecord[]
  emergencyContacts      EmergencyContact[]
  smallGroupJoinRequests SmallGroupJoinRequest[]
  certificates           Certificate[]
  sacramentRequests      SacramentRequest[]
  notifications          Notification[]
  activityLogs           MemberActivityLog[]
  bibleReadingProgresses MemberReadingProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SacramentRecord {
  id         String        @id @default(uuid())
  type       SacramentType
  date       DateTime
  location   String?
  pastorName String?

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Phase 2 & 4: Enhanced Communication Models
// ==========================================

enum AnnouncementAudience {
  ALL
  LEADERS
  MEMBERS
}

enum CommLogStatus {
  PENDING
  SENT
  FAILED
}

enum CommunicationChannel {
  INBOX
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  content     String               @db.Text
  audience    AnnouncementAudience @default(ALL)
  publishDate DateTime             @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunicationTemplate {
  id      String               @id @default(uuid())
  name    String
  subject String
  body    String               @db.Text
  channel CommunicationChannel @default(INBOX)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunicationLog {
  id          String               @id @default(uuid())
  recipient   String
  subject     String
  body        String               @db.Text
  channel     CommunicationChannel @default(INBOX)
  status      CommLogStatus        @default(PENDING)
  errorDetail String?              @db.Text
  metadata    Json? // For tracking extra info like message IDs from providers

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String           @db.Text
  data  Json? // payload tambahan: { requestId, requestType, etc. }

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
}

enum NotificationType {
  APPROVAL // Sakramen, Facility Booking approved/rejected
  REJECTION
  BIRTHDAY // Happy Birthday
  BULK_GREETING // Happy Sunday, dll
  SYSTEM // Pengumuman gereja
  PRAYER // Doa dijawab/didoakan
}

model Newsletter {
  id          String   @id @default(uuid())
  title       String
  content     String?  @db.Text
  coverUrl    String?
  pdfUrl      String? // Link to PDF bulletin if exists
  publishDate DateTime @default(now())
  isActive    Boolean  @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Phase 2: Basic Financial Management
// ==========================================

enum TransactionType {
  OFFERING
  DONATION
  EXPENSE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model FinancialRecord {
  id           String          @id @default(uuid())
  type         TransactionType
  amount       Float
  currency     String          @default("IDR")
  exchangeRate Float           @default(1.0)
  date         DateTime        @default(now())

  category    String
  description String @db.Text
  receiptCode String @unique

  paymentStatus PaymentStatus @default(COMPLETED)
  paymentMethod String? // CASH, TRANSFER, XENDIT, etc.
  externalId    String?       @unique // ID from payment gateway
  proofUrl      String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  projectId String?
  project   DonationProject? @relation(fields: [projectId], references: [id])

  pledgeId String?
  pledge   Pledge? @relation(fields: [pledgeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DonationProject {
  id           String    @id @default(uuid())
  name         String
  description  String?   @db.Text
  targetAmount Float?
  startDate    DateTime  @default(now())
  endDate      DateTime?
  isActive     Boolean   @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  records FinancialRecord[]
  pledges Pledge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pledge {
  id        String    @id @default(uuid())
  amount    Float
  startDate DateTime  @default(now())
  endDate   DateTime?
  status    String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  projectId String?
  project   DonationProject? @relation(fields: [projectId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  records FinancialRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id       String @id @default(uuid())
  year     Int
  month    Int? // Null means yearly budget
  category String
  amount   Float

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, year, month, category])
}

// ==========================================
// Phase 3: Event Management
// ==========================================

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
}

model Event {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  type        String // e.g. SERVICE, SEMINAR, RETREAT
  startDate   DateTime
  endDate     DateTime
  location    String?

  capacity           Int? // Null = unlimited
  isRegistrationOpen Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations EventRegistration[]
  attendance    AttendanceRecord[]
  rosters       ServiceRoster[]
}

model EventRegistration {
  id       String  @id @default(uuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  name  String
  email String?
  phone String?

  status      RegistrationStatus @default(REGISTERED)
  checkInTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, email])
}

// ==========================================
// Phase 4: Attendance Tracking
// ==========================================

model WorshipService {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  dayOfWeek   Int? // 0-6 (Sunday to Saturday)
  startTime   String? // HH:MM
  location    String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance AttendanceRecord[]
  rosters    ServiceRoster[]
}

model AttendanceRecord {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  guestName  String?
  guestPhone String?

  // Link to either a WorshipService or an Event
  worshipServiceId String?
  worshipService   WorshipService? @relation(fields: [worshipServiceId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  date        DateTime // The date of service/event
  checkInTime DateTime @default(now())
  method      String   @default("MANUAL") // MANUAL, QR

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent double check-in for same service on same day (for same member)
  @@unique([memberId, worshipServiceId, date])
}

// ==========================================
// Phase 3: Operational Modules - Small Groups
// ==========================================

enum GroupType {
  CELL_GROUP // Sel
  FELLOWSHIP // Persekutuan
  COMMISSION // Komisi
  MINISTRY // Pelayanan
}

enum GroupRole {
  LEADER
  ASSISTANT
  TREASURER
  MEMBER
}

model SmallGroup {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?   @db.Text
  type        GroupType @default(CELL_GROUP)

  meetingSchedule String? // e.g. "Every Friday 19:00"
  location        String?

  members      SmallGroupMember[]
  meetings     SmallGroupMeeting[]
  joinRequests SmallGroupJoinRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmallGroupMember {
  id      String     @id @default(uuid())
  groupId String
  group   SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, memberId])
}

model SmallGroupJoinRequest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  groupId String
  group   SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status String  @default("PENDING") // PENDING, APPROVED, REJECTED
  notes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, memberId])
}

model SmallGroupMeeting {
  id      String     @id @default(uuid())
  groupId String
  group   SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  date  DateTime
  title String?
  notes String?  @db.Text

  attendance SmallGroupAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmallGroupAttendance {
  id        String            @id @default(uuid())
  meetingId String
  meeting   SmallGroupMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status String @default("PRESENT") // PRESENT, ABSENT, EXCUSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent double check-in for same service on same day (for same member)
  @@unique([meetingId, memberId])
}

// ==========================================
// Phase 1: Subscription Models (Retrofit)
// ==========================================

model Plan {
  id             String  @id @default(uuid())
  name           String  @unique
  price_monthly  Decimal @db.Decimal(10, 2)
  price_yearly   Decimal @db.Decimal(10, 2)
  max_members    Int?
  max_users      Int?
  max_storage_gb Int?
  features       Json
  is_active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions        Subscription[] @relation("ActivePlan")
  subscriptionsPending Subscription[] @relation("PendingPlan")
  tenants              Tenant[]

  @@map("plans")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
}

model Subscription {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation("ActivePlan", fields: [planId], references: [id])

  status            SubscriptionStatus @default(active)
  startDate         DateTime           @default(now()) @map("start_date")
  endDate           DateTime           @map("end_date")
  trialEndsAt       DateTime?          @map("trial_ends_at")
  gracePeriodEndsAt DateTime?          @map("grace_period_ends_at")
  suspendedAt       DateTime?          @map("suspended_at")

  pendingPlanId          String?   @map("pending_plan_id")
  pendingPlan            Plan?     @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  pendingPlanEffectiveAt DateTime? @map("pending_plan_effective_at")
  cancelledAt            DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoices Invoice[]

  @@map("subscriptions")
}

enum InvoiceStatus {
  pending
  paid
  failed
  refunded
}

model Invoice {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  amount Decimal       @db.Decimal(10, 2)
  status InvoiceStatus @default(pending)

  dueDate DateTime  @map("due_date")
  paidAt  DateTime? @map("paid_at")

  // Xendit Payment Gateway fields
  xenditInvoiceId String?   @map("xendit_invoice_id")
  invoiceUrl      String?   @map("invoice_url")
  xenditExpiryAt  DateTime? @map("xendit_expiry_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoices")
}

// ==========================================
// Phase 4: Ministry Management
// ==========================================

model Ministry {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  members      MinistryMember[]
  rosters      ServiceRoster[]
  recruitments VolunteerRecruitment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MinistryMember {
  id         String   @id @default(uuid())
  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  role     String   @default("MEMBER") // e.g. LEADER, STAFF, VOLUNTEER
  joinedAt DateTime @default(now())

  @@unique([ministryId, memberId])
}

model Skill {
  id          String  @id @default(uuid())
  name        String // e.g. Guitar, Singing, Teaching, IT
  description String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  members MemberSkill[]

  @@unique([name, tenantId])
}

model MemberSkill {
  id       String @id @default(uuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  proficiency Int? // 1-5

  @@unique([memberId, skillId])
}

model VolunteerRecruitment {
  id         String   @id @default(uuid())
  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  title        String
  description  String  @db.Text
  requirements String? @db.Text
  status       String  @default("OPEN") // OPEN, CLOSED

  applications VolunteerApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VolunteerApplication {
  id            String               @id @default(uuid())
  recruitmentId String
  recruitment   VolunteerRecruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status String  @default("PENDING") // PENDING, APPROVED, REJECTED
  notes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recruitmentId, memberId])
}

model ServiceRoster {
  id         String   @id @default(uuid())
  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  worshipServiceId String?
  worshipService   WorshipService? @relation(fields: [worshipServiceId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  date      DateTime
  startTime String?
  endTime   String?

  positions ServicePosition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServicePosition {
  id       String        @id @default(uuid())
  rosterId String
  roster   ServiceRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  role String // e.g. WL, Singer, Guitarist, Usher

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  notes String?
}

model PastoralVisitation {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  visitorName String
  visitDate   DateTime
  type        String // HOME, HOSPITAL, OTHER
  status      String // PLANNED, COMPLETED, CANCELLED
  purpose     String
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CounselingRecord {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  counselorId      String? // References User id
  counselorName    String
  counselingDate   DateTime
  title            String
  issueDescription String   @db.Text
  actionPlan       String?  @db.Text
  notes            String   @db.Text // Highly confidential session notes
  isPrivate        Boolean  @default(true) // Privacy flag
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PrayerRequest {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  requesterName  String
  requesterEmail String?
  requesterPhone String?
  content        String   @db.Text
  isAnonymous    Boolean  @default(false)
  isPrivate      Boolean  @default(false) // Pastor-only or leader-only
  status         String   @default("PENDING") // PENDING, ACTIVE, ANSWERED
  prayerCount    Int      @default(0)
  notes          String?  @db.Text // Response or testimony notes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CareGroup {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?           @db.Text
  leaderName  String?
  members     CareGroupMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CareGroupMember {
  id       String    @id @default(uuid())
  groupId  String
  group    CareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String
  member   Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())

  @@unique([groupId, memberId])
}

model CrisisRecord {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  crisisType   String // BEREAVEMENT, SICKNESS, FINANCIAL, FAMILY, ACCIDENT, OTHER
  severity     String // LOW, MEDIUM, HIGH, CRITICAL
  description  String   @db.Text
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  assignedToId String? // References User id
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmergencyContact {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// Phase 5: Document Management
// ==========================================

enum DocumentCategory {
  SERMON // Khotbah
  TEACHING // Materi Pengajaran
  WORSHIP // Liturgi / Materi Ibadah
  ADMINISTRATIVE // Berkas Administrasi
  OTHER
}

enum CertificateType {
  BAPTISM // Sidi / Baptis
  MARRIAGE // Nikah
  CONFIRMATION // Konfirmasi / Sidi
  MEMBERSHIP // Surat Pindah Jemaat
  DEDICATION // Penyerahan Anak
  OTHER
}

model Document {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?          @db.Text
  category    DocumentCategory @default(OTHER)
  tags        String? // comma-separated tags

  // Speaker / Author
  speaker String?
  date    DateTime? // tanggal khotbah/pengajaran

  // File metadata
  fileUrl  String? // path ke file saat ini
  fileType String? // application/pdf, audio/mp3, etc.
  fileSize Int? // bytes
  fileName String? // original filename

  // Version control
  currentVersion Int @default(1)

  isPublic Boolean @default(false) // Bisa diakses jemaat umum

  versions DocumentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  version    Int
  fileUrl    String
  fileType   String?
  fileSize   Int?
  fileName   String?
  uploadedBy String? // userId yang upload

  notes String? @db.Text // changelog notes

  createdAt DateTime @default(now())
}

model Certificate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  type              CertificateType
  certificateNumber String // auto-generated e.g. CERT-BAPT-2024-0001

  // Recipient info (for non-member or guest certs)
  recipientName    String
  recipientAddress String?

  // Event details
  issuedDate DateTime
  issuedBy   String // Pastor/pendeta yang menandatangani
  location   String?

  // Template & file
  templateId String?
  template   CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  fileUrl    String? // generated PDF path

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sacramentRequest SacramentRequest? @relation("SacramentRequestCertificate")

  @@unique([tenantId, certificateNumber])
}

model SacramentRequest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type   CertificateType // BAPTISM, MARRIAGE, CONFIRMATION, MEMBERSHIP, OTHER
  status String          @default("PENDING") // PENDING, APPROVED, REJECTED

  pastorName String?
  date       DateTime?
  location   String?

  // requirements: JSON array of uploaded documents/keys
  requirements Json?

  notes String? @db.Text

  certificateId String?      @unique
  certificate   Certificate? @relation("SacramentRequestCertificate", fields: [certificateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CertificateTemplate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  type      CertificateType
  content   String          @db.Text // HTML template content
  isDefault Boolean         @default(false)

  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Phase 5: Facility Management
// ==========================================

enum FacilityType {
  SANCTUARY // Gedung ibadah utama
  MEETING_ROOM // Ruang rapat
  HALL // Aula / serba guna
  OFFICE // Kantor
  KITCHEN // Dapur
  STORAGE // Gudang
  OTHER
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  OUT_OF_SERVICE
}

enum EquipmentLogAction {
  CHECKED_OUT
  RETURNED
  MAINTENANCE
  REPAIR
  INSPECTION
}

enum MaintenanceFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum UtilityType {
  ELECTRICITY
  WATER
  INTERNET
  GAS
  OTHER
}

model Facility {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  type        FacilityType @default(OTHER)
  capacity    Int?
  location    String? // e.g. "Lantai 2 Gedung A"
  description String?      @db.Text
  amenities   String? // comma-separated: "AC, Proyektor, Sound System"
  isActive    Boolean      @default(true)

  bookings     FacilityBooking[]
  maintenances MaintenanceSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FacilityBooking {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  requestedBy String // userId or name
  purpose     String
  description String?       @db.Text
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus @default(PENDING)
  approvedBy  String?
  notes       String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                String
  category            String // e.g. "Audio", "Lighting", "Furniture"
  serialNumber        String?
  purchaseDate        DateTime?
  purchasePrice       Float?
  condition           EquipmentCondition @default(GOOD)
  location            String?
  description         String?            @db.Text
  nextMaintenanceDate DateTime?
  isActive            Boolean            @default(true)

  logs         EquipmentLog[]
  maintenances MaintenanceSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EquipmentLog {
  id          String    @id @default(uuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  action      EquipmentLogAction
  performedBy String
  notes       String?            @db.Text
  date        DateTime           @default(now())

  createdAt DateTime @default(now())
}

model MaintenanceSchedule {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?              @db.Text
  type        String // "ELECTRICAL", "PLUMBING", "HVAC", "CLEANING", "GENERAL"
  frequency   MaintenanceFrequency @default(ONE_TIME)
  status      MaintenanceStatus    @default(PENDING)

  facilityId  String?
  facility    Facility?  @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  scheduledDate DateTime
  completedDate DateTime?
  assignedTo    String?
  cost          Float?
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UtilityRecord {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type          UtilityType
  month         Int // 1-12
  year          Int
  amount        Float // total tagihan (Rp)
  usage         Float? // kwh, m3, dll
  unit          String? // "kWh", "m³", "Mbps"
  vendor        String?
  invoiceNumber String?
  isPaid        Boolean     @default(false)
  notes         String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, type, month, year])
}

// ==========================================
// Phase 6: Reporting & Analytics
// ==========================================

enum ReportModule {
  MEMBERSHIP
  ATTENDANCE
  FINANCE
  CUSTOM
}

model ReportTemplate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?      @db.Text
  module      ReportModule @default(CUSTOM)
  config      Json // Stores selected columns, filters, groupings
  isPublic    Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Phase 7: Mobile & Digital Engagement
// ==========================================

model Sermon {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  preacher    String?
  date        DateTime
  videoUrl    String?
  audioUrl    String?
  description String?  @db.Text
  isPublished Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bulletin {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  date        DateTime
  content     String?  @db.Text
  pdfUrl      String?
  isPublished Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DigitalConfig {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  liveStreamUrl     String?
  websiteApiKey     String? @unique // Used for public API authentication from church website
  socialWebhookUrl  String? // Zapier / Make.com webhook URL for auto-posting
  autoPostSermons   Boolean @default(false)
  autoPostBulletins Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Phase 8: Daily Devotion & Bible Reading Plan
// ==========================================

model DailyDevotion {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title              String
  scriptureReference String
  passageText        String?  @db.Text
  content            String   @db.Text
  author             String   @default("Tim Pastoral")
  publishDate        DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([publishDate])
}

model BibleReadingPlan {
  id          String                 @id @default(uuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?                @db.Text
  durationDays Int
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  
  days        BibleReadingPlanDay[]
  enrollments MemberReadingProgress[]

  @@index([tenantId])
}

model BibleReadingPlanDay {
  id             String           @id @default(uuid())
  planId         String
  plan           BibleReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber      Int
  scripturePassage String
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([planId, dayNumber])
}

model MemberReadingProgress {
  id          String           @id @default(uuid())
  memberId    String
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId      String
  plan        BibleReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  completedDays Json           @default("[]")
  startDate   DateTime         @default(now())
  lastReadAt  DateTime?
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([memberId, planId])
}
